table 'Sales 2024'
    column Amount
        sourceColumn: Amount
    column Region
        sourceColumn: Region
    column Note
        sourceColumn: Note
    column Code
        sourceColumn: Code

    partition 'Sales 2024' = m
        mode: import
        source =
            let
                Renamed = Table.RenameColumns(#"Raw 2024", {{"amt", "Amount"}})
            in
                Renamed
